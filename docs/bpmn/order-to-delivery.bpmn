<bpmndi:BPMNEdge id="m3_di" bpmnElement="m3"><di:waypoint x="860" y="100"/><di:waypoint x="860" y="212"/><bpmndi:BPMNLabel><dc:Bounds x="866" y="108" width="170" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>

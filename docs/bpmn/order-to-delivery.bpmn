<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_order_to_delivery" targetNamespace="https://github.com/korepkorep/shop-backend" exporter="handwritten" exporterVersion="0.1">
<bpmn:collaboration id="collab">
<bpmn:documentation>ShopCore: процесс от оформления заказа до доставки. Источник: docs/05-flows.md, раздел 4.</bpmn:documentation>
<bpmn:participant id="p_buyer" name="Покупатель"/>
<bpmn:participant id="p_shop" name="ShopCore" processRef="proc_order"/>
<bpmn:participant id="p_psp" name="Платёжный провайдер (PSP)"/>
<bpmn:messageFlow id="m1" name="POST /orders" sourceRef="p_buyer" targetRef="start"/>
<bpmn:messageFlow id="m2" name="POST /payments" sourceRef="p_buyer" targetRef="ev_payreq"/>
<bpmn:messageFlow id="m3" name="POST /cancel" sourceRef="p_buyer" targetRef="ev_cancel"/>
<bpmn:messageFlow id="m4" name="Создать платёж (REST)" sourceRef="t_payment" targetRef="p_psp"/>
<bpmn:messageFlow id="m5" name="Оплата на странице PSP" sourceRef="p_buyer" targetRef="p_psp"/>
<bpmn:messageFlow id="m6" name="Вебхук об успешной оплате (HMAC)" sourceRef="p_psp" targetRef="ev_paid"/>
</bpmn:collaboration>
<bpmn:process id="proc_order" name="Заказ: от оформления до доставки" isExecutable="false">
<bpmn:laneSet id="ls">
<bpmn:lane id="lane_sys" name="Система"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t_create</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_payreq</bpmn:flowNodeRef><bpmn:flowNodeRef>t_payment</bpmn:flowNodeRef><bpmn:flowNodeRef>gw</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_cancel</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_paid</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_timer</bpmn:flowNodeRef><bpmn:flowNodeRef>t_cancel</bpmn:flowNodeRef><bpmn:flowNodeRef>t_paid</bpmn:flowNodeRef><bpmn:flowNodeRef>t_expire</bpmn:flowNodeRef><bpmn:flowNodeRef>end_cancel</bpmn:flowNodeRef><bpmn:flowNodeRef>end_expired</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_adm" name="Администратор"><bpmn:flowNodeRef>t_ship</bpmn:flowNodeRef><bpmn:flowNodeRef>t_deliver</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="start" name="Запрос на оформление"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:messageEventDefinition id="start_md"/></bpmn:startEvent>
<bpmn:serviceTask id="t_create" name="Зарезервировать товар, создать заказ (created, expires_at = +15 мин)"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:intermediateCatchEvent id="ev_payreq" name="Запрос оплаты"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing><bpmn:messageEventDefinition id="ev_payreq_md"/></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="t_payment" name="Создать платёж в PSP, вернуть payment_url"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:eventBasedGateway id="gw" name=""><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="ev_cancel" name="Запрос отмены"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:messageEventDefinition id="ev_cancel_md"/></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="ev_paid" name="Оплата подтверждена"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:messageEventDefinition id="ev_paid_md"/></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="ev_timer" name="Наступил expires_at"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing><bpmn:timerEventDefinition id="ev_timer_td"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">${expiresAt}</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="t_cancel" name="Снять резерв, статус cancelled"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_paid" name="Списать товар со склада, статус paid, чек покупателю"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_expire" name="Снять резерв, статус expired, уведомить покупателя"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="end_cancel" name="Заказ отменён"><bpmn:incoming>f11</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="end_expired" name="Заказ истёк"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="t_ship" name="Отгрузить заказ"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t_deliver" name="Отметить доставку"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="end_ok" name="Заказ доставлен"><bpmn:incoming>f15</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_create"/>
<bpmn:sequenceFlow id="f2" sourceRef="t_create" targetRef="ev_payreq"/>
<bpmn:sequenceFlow id="f3" sourceRef="ev_payreq" targetRef="t_payment"/>
<bpmn:sequenceFlow id="f4" sourceRef="t_payment" targetRef="gw"/>
<bpmn:sequenceFlow id="f5" sourceRef="gw" targetRef="ev_cancel"/>
<bpmn:sequenceFlow id="f6" sourceRef="gw" targetRef="ev_paid"/>
<bpmn:sequenceFlow id="f7" sourceRef="gw" targetRef="ev_timer"/>
<bpmn:sequenceFlow id="f8" sourceRef="ev_cancel" targetRef="t_cancel"/>
<bpmn:sequenceFlow id="f9" sourceRef="ev_paid" targetRef="t_paid"/>
<bpmn:sequenceFlow id="f10" sourceRef="ev_timer" targetRef="t_expire"/>
<bpmn:sequenceFlow id="f11" sourceRef="t_cancel" targetRef="end_cancel"/>
<bpmn:sequenceFlow id="f12" sourceRef="t_expire" targetRef="end_expired"/>
<bpmn:sequenceFlow id="f13" sourceRef="t_paid" targetRef="t_ship"/>
<bpmn:sequenceFlow id="f14" sourceRef="t_ship" targetRef="t_deliver"/>
<bpmn:sequenceFlow id="f15" sourceRef="t_deliver" targetRef="end_ok"/>
<bpmn:textAnnotation id="a1"><bpmn:text>Упрощение: отмена и истечение возможны и до запроса оплаты. Повторный запрос оплаты при активном платеже возвращает тот же платёж (BR-06).</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="a2"><bpmn:text>payment.failed: заказ остаётся created, покупатель может создать новый платёж до expires_at (05-flows, 3.2).</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="a3"><bpmn:text>BR-10. Оплата после истечения: товар есть — заказ восстанавливается в paid, товара нет — автоматический возврат (05-flows, 3.2).</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="a3_as" sourceRef="a3" targetRef="end_expired"/>
<bpmn:textAnnotation id="a4"><bpmn:text>Возврат оплаченного заказа администратором — 05-flows, 3.3.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
<bpmndi:BPMNDiagram id="dia"><bpmndi:BPMNPlane id="plane" bpmnElement="collab">
<bpmndi:BPMNShape id="p_buyer_di" bpmnElement="p_buyer" isHorizontal="true"><dc:Bounds x="160" y="40" width="1800" height="60"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="p_shop_di" bpmnElement="p_shop" isHorizontal="true"><dc:Bounds x="160" y="140" width="1800" height="510"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="p_psp_di" bpmnElement="p_psp" isHorizontal="true"><dc:Bounds x="160" y="710" width="1800" height="60"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="lane_sys_di" bpmnElement="lane_sys" isHorizontal="true"><dc:Bounds x="190" y="140" width="1770" height="370"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="lane_adm_di" bpmnElement="lane_adm" isHorizontal="true"><dc:Bounds x="190" y="510" width="1770" height="140"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="214" y="312" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="182" y="352" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_create_di" bpmnElement="t_create"><dc:Bounds x="300" y="290" width="140" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ev_payreq_di" bpmnElement="ev_payreq"><dc:Bounds x="482" y="312" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="450" y="352" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_payment_di" bpmnElement="t_payment"><dc:Bounds x="560" y="290" width="140" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="gw_di" bpmnElement="gw"><dc:Bounds x="755" y="305" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ev_cancel_di" bpmnElement="ev_cancel"><dc:Bounds x="842" y="212" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="810" y="252" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ev_paid_di" bpmnElement="ev_paid"><dc:Bounds x="842" y="312" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="800" y="278" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ev_timer_di" bpmnElement="ev_timer"><dc:Bounds x="842" y="412" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="810" y="452" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_cancel_di" bpmnElement="t_cancel"><dc:Bounds x="930" y="190" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_paid_di" bpmnElement="t_paid"><dc:Bounds x="930" y="290" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_expire_di" bpmnElement="t_expire"><dc:Bounds x="930" y="390" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="end_cancel_di" bpmnElement="end_cancel"><dc:Bounds x="1132" y="212" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1100" y="252" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="end_expired_di" bpmnElement="end_expired"><dc:Bounds x="1132" y="412" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1100" y="452" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_ship_di" bpmnElement="t_ship"><dc:Bounds x="1495" y="540" width="130" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_deliver_di" bpmnElement="t_deliver"><dc:Bounds x="1675" y="540" width="130" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok"><dc:Bounds x="1862" y="562" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1830" y="602" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="250" y="330"/><di:waypoint x="300" y="330"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="440" y="330"/><di:waypoint x="482" y="330"/></bpmndi:BPMNEdge>

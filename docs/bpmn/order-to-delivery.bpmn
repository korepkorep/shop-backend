<bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="1625" y="580"/><di:waypoint x="1675" y="580"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f15_di" bpmnElement="f15"><di:waypoint x="1805" y="580"/><di:waypoint x="1862" y="580"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="m1_di" bpmnElement="m1"><di:waypoint x="232" y="100"/><di:waypoint x="232" y="312"/><bpmndi:BPMNLabel><dc:Bounds x="238" y="108" width="170" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>

<bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="780" y="305"/><di:waypoint x="780" y="230"/><di:waypoint x="842" y="230"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="805" y="330"/><di:waypoint x="842" y="330"/></bpmndi:BPMNEdge>

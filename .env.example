# Скопируйте в .env и поменяйте секреты. docker compose подхватит .env автоматически.
JWT_SECRET=dev-only-secret-change-me-in-env-0123456789
PSP_WEBHOOK_SECRET=psp-secret-change-me

# 900 = 15 минут. Для демо истечения заказа можно поставить 60.
RESERVATION_TTL_SECONDS=900
# Паузы между повторами отправки письма, секунды. Для демо: 5,10,15
NOTIFY_RETRY_DELAYS_SECONDS=60,300,900
# Вероятность, что мок PSP пришлёт дубль вебхука (0..1)
PSP_DUPLICATE_WEBHOOK_PROBABILITY=0.3
